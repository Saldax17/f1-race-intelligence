        <mxCell id="s_map" value="&lt;font style=&quot;font-size:11.5px&quot; color=&quot;#e8eef8&quot;&gt;&lt;b&gt;PerSessionPipeline · Map (INLINE)&lt;/b&gt;&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#9aaac4&quot;&gt;una iteración por sesión del plan · MaxConcurrency=1&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#9aaac4&quot;&gt;M2 → M3 → M4 → M5, una tarea Fargate por etapa&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#9aaac4&quot;&gt;cada tarea: Retry + Choice sobre Containers[0].ExitCode&lt;/font&gt;&lt;br&gt;&lt;font style=&quot;font-size:10px&quot; color=&quot;#9aaac4&quot;&gt;M3 en FAIL se registra, no es fallo de tarea&lt;/font&gt;" style="rounded=1;arcSize=4.109589041095891;whiteSpace=nowrap;html=1;fillColor=#14223b;strokeColor=#9b8cff;strokeWidth=1.4;align=left;verticalAlign=middle;spacingLeft=9;spacingRight=6;spacingTop=3;fontFamily=Segoe UI;fontColor=#e8eef8;" vertex="1" parent="1"><mxGeometry x="347.0" y="538.0" width="356" height="146" as="geometry"/></mxCell>
