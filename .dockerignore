# Only code, configuration and packaging metadata go into the image.

# Data, notebooks, local artifacts: never baked into the image
data/
notebooks/
logs/
*.parquet
*.joblib
*.png
*.jpg

# Secrets and local environment
.env
.env.*
!.env.example
.aws/
*.pem
*.key

# VCS, virtualenvs, caches, IDE
.git/
.gitignore
.venv/
venv/
__pycache__/
*.py[cod]
*.egg-info/
build/
dist/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.ipynb_checkpoints/
.vscode/
.idea/
Microsoft/

# Not needed at runtime
tests/
infra/
scripts/
Dockerfile
.dockerignore
