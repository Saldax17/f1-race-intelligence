# Python
__pycache__/
*.py[cod]
*.egg-info/
.eggs/
*.egg
dist/
build/

# Environments
.venv/
venv/
.env

# Tooling caches
.pytest_cache/
.mypy_cache/
.ruff_cache/

# Notebooks
.ipynb_checkpoints/

# Data (folder structure is versioned, raw content is not)
data/raw/*
!data/raw/.gitkeep
data/processed/*
!data/processed/.gitkeep
data/features/*
!data/features/.gitkeep
data/manifests/*
!data/manifests/.gitkeep
data/validation/*
!data/validation/.gitkeep
data/consolidation/*
!data/consolidation/.gitkeep
data/modeling/*
!data/modeling/.gitkeep
# Local rehearsal of the S3 data lake layout, and ad-hoc run outputs
data/lake/
data/smoke/

# Development log files (logs always go to stdout as well)
logs/
*.log

# Cloud credentials must never be committed
.aws/
*.pem

# IDE
.vscode/
.idea/

# Stray PowerShell cache (created accidentally in this directory)
/Microsoft/

# SAM build output
.aws-sam/
