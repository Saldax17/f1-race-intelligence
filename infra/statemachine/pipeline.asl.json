{
  "Comment": "F1 Race Intelligence pipeline orchestration (${Environment}). Input: the OpenF1 availability checker result. Every stage is a Fargate task of the batch image (python -m f1_race_intelligence --stage ...); all intermediate data lives in S3 (lake layout), so no stage depends on another task's disk. Nothing runs while PipelineEnabled=false.",
  "TimeoutSeconds": 43200,
  "StartAt": "LoadContext",
  "States": {
    "LoadContext": {
      "Type": "Pass",
      "Comment": "Keep the availability verdict and the deployment switches side by side.",
      "Parameters": {
        "availability.$": "$",
        "config": {
          "environment": "${Environment}",
          "pipeline_enabled": "${PipelineEnabled}",
          "data_bucket": "${DataBucketName}"
        },
        "execution_id.$": "$$.Execution.Id"
      },
      "Next": "IsAvailabilityResultValid"
    },
    "IsAvailabilityResultValid": {
      "Type": "Choice",
      "Comment": "An execution started by hand or by a malformed event must not be mistaken for 'unavailable'.",
      "Choices": [
        {
          "Variable": "$.availability.available",
          "IsBoolean": true,
          "Next": "IsOpenF1Available"
        }
      ],
      "Default": "InvalidAvailabilityResult"
    },
    "InvalidAvailabilityResult": {
      "Type": "Fail",
      "Error": "InvalidAvailabilityResult",
      "Cause": "The execution input does not contain a boolean 'available' field produced by the OpenF1 availability checker."
    },
    "IsOpenF1Available": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.availability.available",
          "BooleanEquals": true,
          "Next": "IsPipelineEnabled"
        }
      ],
      "Default": "OpenF1Unavailable"
    },
    "OpenF1Unavailable": {
      "Type": "Succeed",
      "Comment": "Expected outcome (live-session restriction, rate limit, OpenF1 error): end cleanly, run nothing, try again at the next scheduled check."
    },
    "IsPipelineEnabled": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.config.pipeline_enabled",
          "StringEquals": "true",
          "Next": "CheckForConcurrentRun"
        }
      ],
      "Default": "PipelineDisabled"
    },
    "PipelineDisabled": {
      "Type": "Succeed",
      "Comment": "OpenF1 is available but the data-processing tasks are not enabled in this deployment (PipelineEnabled=false)."
    },
    "CheckForConcurrentRun": {
      "Type": "Task",
      "Comment": "Every successful availability check starts an execution. Count the RUNNING executions of this state machine (this one included) so two runs never extract the history at the same time.",
      "Resource": "arn:aws:states:::aws-sdk:sfn:listExecutions",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "StatusFilter": "RUNNING",
        "MaxResults": 2
      },
      "ResultSelector": {
        "running.$": "States.ArrayLength($.Executions)"
      },
      "ResultPath": "$.concurrency",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ],
      "Next": "IsAnotherRunInProgress"
    },
    "IsAnotherRunInProgress": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.concurrency.running",
          "NumericGreaterThan": 1,
          "Next": "AnotherRunInProgress"
        }
      ],
      "Default": "ResolveExtractionScope"
    },
    "AnotherRunInProgress": {
      "Type": "Succeed",
      "Comment": "Another execution is already processing; this one stops without running any task."
    },
    "PlanSessions": {
      "Type": "Task",
      "Comment": "Plan only sessions whose M2-M5 artifacts are missing, changed or unverifiable. Current-season metadata is refreshed only when its saved catalog is stale; a task's stdout cannot be read by Step Functions. F1_EXTRACTION_YEARS limits planning to the seasons of this backfill phase (empty keeps the configured seasons).",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "Cluster": "${ClusterArn}",
        "TaskDefinition": "${TaskDefinitionArn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${SubnetA}", "${SubnetB}"],
            "SecurityGroups": ["${TaskSecurityGroupId}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "pipeline",
              "Command.$": "States.Array('--stage', 'plan', '--plan-output', States.Format('s3://${DataBucketName}/manifests/plan/{}.json', $$.Execution.Name))",
              "Environment": [
                {
                  "Name": "F1_PIPELINE_EXECUTION_ID",
                  "Value.$": "$$.Execution.Id"
                },
                {
                  "Name": "F1_EXTRACTION_YEARS",
                  "Value.$": "$.scope.value"
                }
              ]
            }
          ]
        }
      },
      "ResultPath": "$.plan_task",
      "TimeoutSeconds": 1800,
      "Retry": [
        {
          "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 120,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ],
      "Next": "CheckPlanExitCode"
    },
    "CheckPlanExitCode": {
      "Type": "Choice",
      "Comment": "Validates the stored ECS result in separate steps: a numeric ExitCode of 0 is the only success; any other number is a failed stage; a missing Containers/ExitCode or a non-numeric one is a malformed result. Nothing dereferences Containers[0].ExitCode before this Choice, so a bad result cannot raise States.Runtime.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.plan_task.Containers[0].ExitCode",
              "IsPresent": true
            },
            {
              "Variable": "$.plan_task.Containers[0].ExitCode",
              "IsNumeric": true
            },
            {
              "Variable": "$.plan_task.Containers[0].ExitCode",
              "NumericEquals": 0
            }
          ],
          "Next": "LoadPlan"
        },
        {
          "And": [
            {
              "Variable": "$.plan_task.Containers[0].ExitCode",
              "IsPresent": true
            },
            {
              "Variable": "$.plan_task.Containers[0].ExitCode",
              "IsNumeric": true
            }
          ],
          "Next": "PlanExitedNonZero"
        }
      ],
      "Default": "PlanResultMalformed"
    },
    "PlanExitedNonZero": {
      "Type": "Pass",
      "Result": {
        "Error": "StageExitedNonZero",
        "Cause": "The plan task exited with a non-zero code; see its logs in the pipeline log group."
      },
      "ResultPath": "$.error",
      "Next": "NotifyPipelineFailure"
    },
    "LoadPlan": {
      "Type": "Task",
      "Comment": "Read the plan document written to S3, retaining both included sessions and per-session inclusion/omission reasons.",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket": "${DataBucketName}",
        "Key.$": "States.Format('manifests/plan/{}.json', $$.Execution.Name)"
      },
      "ResultSelector": {
        "document.$": "States.StringToJson($.Body)"
      },
      "ResultPath": "$.plan",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ],
      "Next": "PerSessionPipeline"
    },
    "PerSessionPipeline": {
      "Type": "Map",
      "Comment": "One iteration per session: M2 -> M3 -> M4 -> M5, one Fargate task each, every stage reading its inputs from and writing its outputs to S3. MaxConcurrency stays at 1 because every M2 calls OpenF1, a shared public API with a per-client rate limit.",
      "ItemsPath": "$.plan.document.sessions",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "session.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "M2_Extraction",
        "States": {
          "M2_Extraction": {
            "Type": "Task",
            "Comment": "--stage m2 for one session: raw OpenF1 data to raw/ and the extraction manifest to manifests/extraction/. Exit code 1 means a retryable extraction failure.",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "PlatformVersion": "LATEST",
              "Cluster": "${ClusterArn}",
              "TaskDefinition": "${TaskDefinitionArn}",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetA}", "${SubnetB}"],
                  "SecurityGroups": ["${TaskSecurityGroupId}"],
                  "AssignPublicIp": "ENABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "pipeline",
                    "Command.$": "States.Array('--stage', 'm2', '--year', States.Format('{}', $.session.year), '--meeting-key', States.Format('{}', $.session.meeting_key), '--session-key', States.Format('{}', $.session.session_key))",
                    "Environment": [
                      {
                        "Name": "F1_PIPELINE_EXECUTION_ID",
                        "Value.$": "$$.Execution.Id"
                      }
                    ]
                  }
                ]
              }
            },
            "ResultPath": "$.m2",
            "TimeoutSeconds": 1800,
            "Retry": [
              {
                "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
                "IntervalSeconds": 60,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 120,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Next": "CheckM2ExitCode"
          },
          "CheckM2ExitCode": {
            "Type": "Choice",
            "Choices": [
              {
                "And": [
                  {
                    "Variable": "$.m2.Containers[0].ExitCode",
                    "IsPresent": true
                  },
                  {
                    "Variable": "$.m2.Containers[0].ExitCode",
                    "IsNumeric": true
                  },
                  {
                    "Variable": "$.m2.Containers[0].ExitCode",
                    "NumericEquals": 0
                  }
                ],
                "Next": "M3_Validation"
              },
              {
                "And": [
                  {
                    "Variable": "$.m2.Containers[0].ExitCode",
                    "IsPresent": true
                  },
                  {
                    "Variable": "$.m2.Containers[0].ExitCode",
                    "IsNumeric": true
                  }
                ],
                "Next": "M2ExitedNonZero"
              }
            ],
            "Default": "M2ResultMalformed",
            "Comment": "Validates the stored ECS result in separate steps: a numeric ExitCode of 0 is the only success; any other number is a failed stage; a missing Containers/ExitCode or a non-numeric one is a malformed result. Nothing dereferences Containers[0].ExitCode before this Choice, so a bad result cannot raise States.Runtime."
          },
          "M2ExitedNonZero": {
            "Type": "Fail",
            "Error": "StageExitedNonZero",
            "Cause": "M2 (extraction) exited with a non-zero code; see the task logs."
          },
          "M3_Validation": {
            "Type": "Task",
            "Comment": "--stage m3 for the same session: reads raw/ and manifests/extraction/, writes the validation report to validated/. A FAIL verdict is recorded, not a task failure (no --strict), as in the CLI.",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "PlatformVersion": "LATEST",
              "Cluster": "${ClusterArn}",
              "TaskDefinition": "${TaskDefinitionArn}",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetA}", "${SubnetB}"],
                  "SecurityGroups": ["${TaskSecurityGroupId}"],
                  "AssignPublicIp": "ENABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "pipeline",
                    "Command.$": "States.Array('--stage', 'm3', '--year', States.Format('{}', $.session.year), '--session-key', States.Format('{}', $.session.session_key))",
                    "Environment": [
                      {
                        "Name": "F1_PIPELINE_EXECUTION_ID",
                        "Value.$": "$$.Execution.Id"
                      }
                    ]
                  }
                ]
              }
            },
            "ResultPath": "$.m3",
            "TimeoutSeconds": 900,
            "Retry": [
              {
                "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
                "IntervalSeconds": 60,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 60,
                "MaxAttempts": 1
              }
            ],
            "Next": "CheckM3ExitCode"
          },
          "CheckM3ExitCode": {
            "Type": "Choice",
            "Choices": [
              {
                "And": [
                  {
                    "Variable": "$.m3.Containers[0].ExitCode",
                    "IsPresent": true
                  },
                  {
                    "Variable": "$.m3.Containers[0].ExitCode",
                    "IsNumeric": true
                  },
                  {
                    "Variable": "$.m3.Containers[0].ExitCode",
                    "NumericEquals": 0
                  }
                ],
                "Next": "M4_Consolidation"
              },
              {
                "And": [
                  {
                    "Variable": "$.m3.Containers[0].ExitCode",
                    "IsPresent": true
                  },
                  {
                    "Variable": "$.m3.Containers[0].ExitCode",
                    "IsNumeric": true
                  }
                ],
                "Next": "M3ExitedNonZero"
              }
            ],
            "Default": "M3ResultMalformed",
            "Comment": "Validates the stored ECS result in separate steps: a numeric ExitCode of 0 is the only success; any other number is a failed stage; a missing Containers/ExitCode or a non-numeric one is a malformed result. Nothing dereferences Containers[0].ExitCode before this Choice, so a bad result cannot raise States.Runtime."
          },
          "M3ExitedNonZero": {
            "Type": "Fail",
            "Error": "StageExitedNonZero",
            "Cause": "M3 (validation) exited with a non-zero code; see the task logs."
          },
          "M4_Consolidation": {
            "Type": "Task",
            "Comment": "--stage m4 for the same session: reads raw/ and validated/, writes consolidated/ and manifests/consolidation/.",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "PlatformVersion": "LATEST",
              "Cluster": "${ClusterArn}",
              "TaskDefinition": "${TaskDefinitionArn}",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetA}", "${SubnetB}"],
                  "SecurityGroups": ["${TaskSecurityGroupId}"],
                  "AssignPublicIp": "ENABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "pipeline",
                    "Command.$": "States.Array('--stage', 'm4', '--year', States.Format('{}', $.session.year), '--session-key', States.Format('{}', $.session.session_key), '--overwrite-derived')",
                    "Environment": [
                      {
                        "Name": "F1_PIPELINE_EXECUTION_ID",
                        "Value.$": "$$.Execution.Id"
                      }
                    ]
                  }
                ]
              }
            },
            "ResultPath": "$.m4",
            "TimeoutSeconds": 900,
            "Retry": [
              {
                "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
                "IntervalSeconds": 60,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 60,
                "MaxAttempts": 1
              }
            ],
            "Next": "CheckM4ExitCode"
          },
          "CheckM4ExitCode": {
            "Type": "Choice",
            "Choices": [
              {
                "And": [
                  {
                    "Variable": "$.m4.Containers[0].ExitCode",
                    "IsPresent": true
                  },
                  {
                    "Variable": "$.m4.Containers[0].ExitCode",
                    "IsNumeric": true
                  },
                  {
                    "Variable": "$.m4.Containers[0].ExitCode",
                    "NumericEquals": 0
                  }
                ],
                "Next": "M5_Features"
              },
              {
                "And": [
                  {
                    "Variable": "$.m4.Containers[0].ExitCode",
                    "IsPresent": true
                  },
                  {
                    "Variable": "$.m4.Containers[0].ExitCode",
                    "IsNumeric": true
                  }
                ],
                "Next": "M4ExitedNonZero"
              }
            ],
            "Default": "M4ResultMalformed",
            "Comment": "Validates the stored ECS result in separate steps: a numeric ExitCode of 0 is the only success; any other number is a failed stage; a missing Containers/ExitCode or a non-numeric one is a malformed result. Nothing dereferences Containers[0].ExitCode before this Choice, so a bad result cannot raise States.Runtime."
          },
          "M4ExitedNonZero": {
            "Type": "Fail",
            "Error": "StageExitedNonZero",
            "Cause": "M4 (consolidation) exited with a non-zero code; see the task logs."
          },
          "M5_Features": {
            "Type": "Task",
            "Comment": "--stage m5 for the same session: reads consolidated/, writes features/ and manifests/features/.",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "PlatformVersion": "LATEST",
              "Cluster": "${ClusterArn}",
              "TaskDefinition": "${TaskDefinitionArn}",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetA}", "${SubnetB}"],
                  "SecurityGroups": ["${TaskSecurityGroupId}"],
                  "AssignPublicIp": "ENABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "pipeline",
                    "Command.$": "States.Array('--stage', 'm5', '--year', States.Format('{}', $.session.year), '--session-key', States.Format('{}', $.session.session_key), '--overwrite-derived')",
                    "Environment": [
                      {
                        "Name": "F1_PIPELINE_EXECUTION_ID",
                        "Value.$": "$$.Execution.Id"
                      }
                    ]
                  }
                ]
              }
            },
            "ResultPath": "$.m5",
            "TimeoutSeconds": 900,
            "Retry": [
              {
                "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
                "IntervalSeconds": 60,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 60,
                "MaxAttempts": 1
              }
            ],
            "Next": "CheckM5ExitCode"
          },
          "CheckM5ExitCode": {
            "Type": "Choice",
            "Choices": [
              {
                "And": [
                  {
                    "Variable": "$.m5.Containers[0].ExitCode",
                    "IsPresent": true
                  },
                  {
                    "Variable": "$.m5.Containers[0].ExitCode",
                    "IsNumeric": true
                  },
                  {
                    "Variable": "$.m5.Containers[0].ExitCode",
                    "NumericEquals": 0
                  }
                ],
                "Next": "SessionDone"
              },
              {
                "And": [
                  {
                    "Variable": "$.m5.Containers[0].ExitCode",
                    "IsPresent": true
                  },
                  {
                    "Variable": "$.m5.Containers[0].ExitCode",
                    "IsNumeric": true
                  }
                ],
                "Next": "M5ExitedNonZero"
              }
            ],
            "Default": "M5ResultMalformed",
            "Comment": "Validates the stored ECS result in separate steps: a numeric ExitCode of 0 is the only success; any other number is a failed stage; a missing Containers/ExitCode or a non-numeric one is a malformed result. Nothing dereferences Containers[0].ExitCode before this Choice, so a bad result cannot raise States.Runtime."
          },
          "M5ExitedNonZero": {
            "Type": "Fail",
            "Error": "StageExitedNonZero",
            "Cause": "M5 (features) exited with a non-zero code; see the task logs."
          },
          "SessionDone": {
            "Type": "Succeed"
          },
          "M2ResultMalformed": {
            "Type": "Fail",
            "Error": "StageResultMalformed",
            "Cause": "M2 (extraction) finished without a numeric container ExitCode in the ECS result; see the task and state machine logs."
          },
          "M3ResultMalformed": {
            "Type": "Fail",
            "Error": "StageResultMalformed",
            "Cause": "M3 (validation) finished without a numeric container ExitCode in the ECS result; see the task and state machine logs."
          },
          "M4ResultMalformed": {
            "Type": "Fail",
            "Error": "StageResultMalformed",
            "Cause": "M4 (consolidation) finished without a numeric container ExitCode in the ECS result; see the task and state machine logs."
          },
          "M5ResultMalformed": {
            "Type": "Fail",
            "Error": "StageResultMalformed",
            "Cause": "M5 (features) finished without a numeric container ExitCode in the ECS result; see the task and state machine logs."
          }
        }
      },
      "ResultPath": null,
      "Next": "M6_ModelingDataset",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ]
    },
    "M6_ModelingDataset": {
      "Type": "Task",
      "Comment": "--stage m6, once every session has been processed: a global batch, since the temporal split needs the whole history (it ignores any session scope). Reads features/, writes modeling/ and manifests/modeling/.",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "Cluster": "${ClusterArn}",
        "TaskDefinition": "${TaskDefinitionArn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${SubnetA}", "${SubnetB}"],
            "SecurityGroups": ["${TaskSecurityGroupId}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "pipeline",
              "Command": ["--stage", "m6", "--require-complete-history"],
              "Environment": [
                {
                  "Name": "F1_PIPELINE_EXECUTION_ID",
                  "Value.$": "$$.Execution.Id"
                }
              ]
            }
          ]
        }
      },
      "ResultPath": "$.m6",
      "TimeoutSeconds": 1800,
      "Retry": [
        {
          "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 60,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ],
      "Next": "CheckM6ExitCode"
    },
    "CheckM6ExitCode": {
      "Type": "Choice",
      "Comment": "Validates the stored ECS result in separate steps: a numeric ExitCode of 0 is the only success; any other number is a failed stage; a missing Containers/ExitCode or a non-numeric one is a malformed result. Nothing dereferences Containers[0].ExitCode before this Choice, so a bad result cannot raise States.Runtime.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.m6.Containers[0].ExitCode",
              "IsPresent": true
            },
            {
              "Variable": "$.m6.Containers[0].ExitCode",
              "IsNumeric": true
            },
            {
              "Variable": "$.m6.Containers[0].ExitCode",
              "NumericEquals": 0
            }
          ],
          "Next": "PipelineSucceeded"
        },
        {
          "And": [
            {
              "Variable": "$.m6.Containers[0].ExitCode",
              "IsPresent": true
            },
            {
              "Variable": "$.m6.Containers[0].ExitCode",
              "IsNumeric": true
            },
            {
              "Variable": "$.m6.Containers[0].ExitCode",
              "NumericEquals": 3
            }
          ],
          "Next": "ModelingDeferredHistoryIncomplete"
        },
        {
          "And": [
            {
              "Variable": "$.m6.Containers[0].ExitCode",
              "IsPresent": true
            },
            {
              "Variable": "$.m6.Containers[0].ExitCode",
              "IsNumeric": true
            }
          ],
          "Next": "M6ExitedNonZero"
        }
      ],
      "Default": "M6ResultMalformed"
    },
    "M6ExitedNonZero": {
      "Type": "Pass",
      "Result": {
        "Error": "StageExitedNonZero",
        "Cause": "M6 (modelling dataset) exited with a non-zero code; see its logs in the pipeline log group."
      },
      "ResultPath": "$.error",
      "Next": "NotifyPipelineFailure"
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    },
    "NotifyPipelineFailure": {
      "Type": "Task",
      "Comment": "Critical: a pipeline stage failed after its retries.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertTopicArn}",
        "Subject": "[${Environment}] F1 Race Intelligence pipeline failed",
        "Message.$": "States.JsonToString($)"
      },
      "ResultPath": "$.notification",
      "Next": "PipelineFailed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "A pipeline stage failed; details were published to the alert topic."
    },
    "ResolveExtractionScope": {
      "Type": "Choice",
      "Comment": "Backfill phases: an execution may name the seasons it covers in availability.extraction_years (comma-separated, e.g. \"2023\"). Absent means the stack default (ExtractionYears parameter; empty = the configured seasons). Any other type is rejected.",
      "Choices": [
        {
          "And": [
            {
              "Variable": "$.availability.extraction_years",
              "IsPresent": true
            },
            {
              "Variable": "$.availability.extraction_years",
              "IsString": true
            }
          ],
          "Next": "UseRequestedYears"
        },
        {
          "Variable": "$.availability.extraction_years",
          "IsPresent": false,
          "Next": "UseConfiguredYears"
        }
      ],
      "Default": "InvalidExtractionScope"
    },
    "UseRequestedYears": {
      "Type": "Pass",
      "Parameters": {
        "value.$": "$.availability.extraction_years"
      },
      "ResultPath": "$.scope",
      "Next": "PlanSessions"
    },
    "UseConfiguredYears": {
      "Type": "Pass",
      "Result": {
        "value": "${DefaultExtractionYears}"
      },
      "ResultPath": "$.scope",
      "Next": "PlanSessions"
    },
    "InvalidExtractionScope": {
      "Type": "Fail",
      "Error": "InvalidExtractionScope",
      "Cause": "availability.extraction_years must be a string such as \"2023\" or \"2023,2024\"."
    },
    "ModelingDeferredHistoryIncomplete": {
      "Type": "Succeed",
      "Comment": "M6 exited 3: stored evidence does not prove every modelling season complete, so it deliberately did not run. The phase succeeded; the backfill is NOT complete. Reasons are in the task logs (m6_deferred, backfill_history_status)."
    },
    "PlanResultMalformed": {
      "Type": "Pass",
      "Result": {
        "Error": "StageResultMalformed",
        "Cause": "The plan task finished without a numeric container ExitCode in the ECS result; see the task and state machine logs."
      },
      "ResultPath": "$.error",
      "Next": "NotifyPipelineFailure"
    },
    "M6ResultMalformed": {
      "Type": "Pass",
      "Result": {
        "Error": "StageResultMalformed",
        "Cause": "M6 (modelling dataset) finished without a numeric container ExitCode in the ECS result; see the task and state machine logs."
      },
      "ResultPath": "$.error",
      "Next": "NotifyPipelineFailure"
    }
  }
}
