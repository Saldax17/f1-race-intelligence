{
  "Comment": "F1 Race Intelligence pipeline orchestration (${Environment}). Input: the OpenF1 availability checker result. Every stage is a Fargate task of the batch image (python -m f1_race_intelligence --stage ...); all intermediate data lives in S3 (lake layout), so no stage depends on another task's disk. Nothing runs while PipelineEnabled=false.",
  "TimeoutSeconds": 43200,
  "StartAt": "LoadContext",
  "States": {
    "LoadContext": {
      "Type": "Pass",
      "Comment": "Keep the availability verdict and the deployment switches side by side.",
      "Parameters": {
        "availability.$": "$",
        "config": {
          "environment": "${Environment}",
          "pipeline_enabled": "${PipelineEnabled}",
          "data_bucket": "${DataBucketName}"
        },
        "execution_id.$": "$$.Execution.Id"
      },
      "Next": "IsAvailabilityResultValid"
    },
    "IsAvailabilityResultValid": {
      "Type": "Choice",
      "Comment": "An execution started by hand or by a malformed event must not be mistaken for 'unavailable'.",
      "Choices": [
        {
          "Variable": "$.availability.available",
          "IsBoolean": true,
          "Next": "IsOpenF1Available"
        }
      ],
      "Default": "InvalidAvailabilityResult"
    },
    "InvalidAvailabilityResult": {
      "Type": "Fail",
      "Error": "InvalidAvailabilityResult",
      "Cause": "The execution input does not contain a boolean 'available' field produced by the OpenF1 availability checker."
    },
    "IsOpenF1Available": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.availability.available",
          "BooleanEquals": true,
          "Next": "IsPipelineEnabled"
        }
      ],
      "Default": "OpenF1Unavailable"
    },
    "OpenF1Unavailable": {
      "Type": "Succeed",
      "Comment": "Expected outcome (live-session restriction, rate limit, OpenF1 error): end cleanly, run nothing, try again at the next scheduled check."
    },
    "IsPipelineEnabled": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.config.pipeline_enabled",
          "StringEquals": "true",
          "Next": "CheckForConcurrentRun"
        }
      ],
      "Default": "PipelineDisabled"
    },
    "PipelineDisabled": {
      "Type": "Succeed",
      "Comment": "OpenF1 is available but the data-processing tasks are not enabled in this deployment (PipelineEnabled=false)."
    },
    "CheckForConcurrentRun": {
      "Type": "Task",
      "Comment": "Every successful availability check starts an execution. Count the RUNNING executions of this state machine (this one included) so two runs never extract the history at the same time.",
      "Resource": "arn:aws:states:::aws-sdk:sfn:listExecutions",
      "Parameters": {
        "StateMachineArn.$": "$$.StateMachine.Id",
        "StatusFilter": "RUNNING",
        "MaxResults": 2
      },
      "ResultSelector": {
        "running.$": "States.ArrayLength($.Executions)"
      },
      "ResultPath": "$.concurrency",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ],
      "Next": "IsAnotherRunInProgress"
    },
    "IsAnotherRunInProgress": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.concurrency.running",
          "NumericGreaterThan": 1,
          "Next": "AnotherRunInProgress"
        }
      ],
      "Default": "PlanSessions"
    },
    "AnotherRunInProgress": {
      "Type": "Succeed",
      "Comment": "Another execution is already processing; this one stops without running any task."
    },
    "PlanSessions": {
      "Type": "Task",
      "Comment": "Discover the session work units of the configured seasons (historical_extraction.years) and write them to S3: a task's stdout cannot be read by Step Functions.",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "Cluster": "${ClusterArn}",
        "TaskDefinition": "${TaskDefinitionArn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${SubnetA}", "${SubnetB}"],
            "SecurityGroups": ["${TaskSecurityGroupId}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "pipeline",
              "Command.$": "States.Array('--stage', 'plan', '--plan-output', States.Format('s3://${DataBucketName}/manifests/plan/{}.json', $$.Execution.Name))"
            }
          ]
        }
      },
      "ResultSelector": {
        "exit_code.$": "$.Containers[0].ExitCode",
        "task_arn.$": "$.TaskArn"
      },
      "ResultPath": "$.plan_task",
      "TimeoutSeconds": 1800,
      "Retry": [
        {
          "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 120,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ],
      "Next": "CheckPlanExitCode"
    },
    "CheckPlanExitCode": {
      "Type": "Choice",
      "Comment": "A non-zero exit fails the stage even if runTask.sync reported the stopped task as a success.",
      "Choices": [
        {
          "Variable": "$.plan_task.exit_code",
          "NumericEquals": 0,
          "Next": "LoadPlan"
        }
      ],
      "Default": "PlanExitedNonZero"
    },
    "PlanExitedNonZero": {
      "Type": "Pass",
      "Result": {
        "Error": "StageExitedNonZero",
        "Cause": "The plan task exited with a non-zero code; see its logs in the pipeline log group."
      },
      "ResultPath": "$.error",
      "Next": "NotifyPipelineFailure"
    },
    "LoadPlan": {
      "Type": "Task",
      "Comment": "Read the work units the plan task wrote: [{year, meeting_key, session_key, session_name}, ...].",
      "Resource": "arn:aws:states:::aws-sdk:s3:getObject",
      "Parameters": {
        "Bucket": "${DataBucketName}",
        "Key.$": "States.Format('manifests/plan/{}.json', $$.Execution.Name)"
      },
      "ResultSelector": {
        "sessions.$": "States.StringToJson($.Body)"
      },
      "ResultPath": "$.plan",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ],
      "Next": "PerSessionPipeline"
    },
    "PerSessionPipeline": {
      "Type": "Map",
      "Comment": "One iteration per session: M2 -> M3 -> M4 -> M5, one Fargate task each, every stage reading its inputs from and writing its outputs to S3. MaxConcurrency stays at 1 because every M2 calls OpenF1, a shared public API with a per-client rate limit.",
      "ItemsPath": "$.plan.sessions",
      "MaxConcurrency": 1,
      "ItemSelector": {
        "session.$": "$$.Map.Item.Value"
      },
      "ItemProcessor": {
        "ProcessorConfig": {
          "Mode": "INLINE"
        },
        "StartAt": "M2_Extraction",
        "States": {
          "M2_Extraction": {
            "Type": "Task",
            "Comment": "--stage m2 for one session: raw OpenF1 data to raw/ and the extraction manifest to manifests/extraction/. Exit code 1 means a retryable extraction failure.",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "PlatformVersion": "LATEST",
              "Cluster": "${ClusterArn}",
              "TaskDefinition": "${TaskDefinitionArn}",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetA}", "${SubnetB}"],
                  "SecurityGroups": ["${TaskSecurityGroupId}"],
                  "AssignPublicIp": "ENABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "pipeline",
                    "Command.$": "States.Array('--stage', 'm2', '--year', States.Format('{}', $.session.year), '--meeting-key', States.Format('{}', $.session.meeting_key), '--session-key', States.Format('{}', $.session.session_key))"
                  }
                ]
              }
            },
            "ResultSelector": {
              "exit_code.$": "$.Containers[0].ExitCode",
              "task_arn.$": "$.TaskArn"
            },
            "ResultPath": "$.m2",
            "TimeoutSeconds": 1800,
            "Retry": [
              {
                "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
                "IntervalSeconds": 60,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 120,
                "MaxAttempts": 2,
                "BackoffRate": 2
              }
            ],
            "Next": "CheckM2ExitCode"
          },
          "CheckM2ExitCode": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.m2.exit_code",
                "NumericEquals": 0,
                "Next": "M3_Validation"
              }
            ],
            "Default": "M2ExitedNonZero"
          },
          "M2ExitedNonZero": {
            "Type": "Fail",
            "Error": "StageExitedNonZero",
            "Cause": "M2 (extraction) exited with a non-zero code; see the task logs."
          },
          "M3_Validation": {
            "Type": "Task",
            "Comment": "--stage m3 for the same session: reads raw/ and manifests/extraction/, writes the validation report to validated/. A FAIL verdict is recorded, not a task failure (no --strict), as in the CLI.",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "PlatformVersion": "LATEST",
              "Cluster": "${ClusterArn}",
              "TaskDefinition": "${TaskDefinitionArn}",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetA}", "${SubnetB}"],
                  "SecurityGroups": ["${TaskSecurityGroupId}"],
                  "AssignPublicIp": "ENABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "pipeline",
                    "Command.$": "States.Array('--stage', 'm3', '--year', States.Format('{}', $.session.year), '--session-key', States.Format('{}', $.session.session_key))"
                  }
                ]
              }
            },
            "ResultSelector": {
              "exit_code.$": "$.Containers[0].ExitCode",
              "task_arn.$": "$.TaskArn"
            },
            "ResultPath": "$.m3",
            "TimeoutSeconds": 900,
            "Retry": [
              {
                "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
                "IntervalSeconds": 60,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 60,
                "MaxAttempts": 1
              }
            ],
            "Next": "CheckM3ExitCode"
          },
          "CheckM3ExitCode": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.m3.exit_code",
                "NumericEquals": 0,
                "Next": "M4_Consolidation"
              }
            ],
            "Default": "M3ExitedNonZero"
          },
          "M3ExitedNonZero": {
            "Type": "Fail",
            "Error": "StageExitedNonZero",
            "Cause": "M3 (validation) exited with a non-zero code; see the task logs."
          },
          "M4_Consolidation": {
            "Type": "Task",
            "Comment": "--stage m4 for the same session: reads raw/ and validated/, writes consolidated/ and manifests/consolidation/.",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "PlatformVersion": "LATEST",
              "Cluster": "${ClusterArn}",
              "TaskDefinition": "${TaskDefinitionArn}",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetA}", "${SubnetB}"],
                  "SecurityGroups": ["${TaskSecurityGroupId}"],
                  "AssignPublicIp": "ENABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "pipeline",
                    "Command.$": "States.Array('--stage', 'm4', '--year', States.Format('{}', $.session.year), '--session-key', States.Format('{}', $.session.session_key))"
                  }
                ]
              }
            },
            "ResultSelector": {
              "exit_code.$": "$.Containers[0].ExitCode",
              "task_arn.$": "$.TaskArn"
            },
            "ResultPath": "$.m4",
            "TimeoutSeconds": 900,
            "Retry": [
              {
                "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
                "IntervalSeconds": 60,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 60,
                "MaxAttempts": 1
              }
            ],
            "Next": "CheckM4ExitCode"
          },
          "CheckM4ExitCode": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.m4.exit_code",
                "NumericEquals": 0,
                "Next": "M5_Features"
              }
            ],
            "Default": "M4ExitedNonZero"
          },
          "M4ExitedNonZero": {
            "Type": "Fail",
            "Error": "StageExitedNonZero",
            "Cause": "M4 (consolidation) exited with a non-zero code; see the task logs."
          },
          "M5_Features": {
            "Type": "Task",
            "Comment": "--stage m5 for the same session: reads consolidated/, writes features/ and manifests/features/.",
            "Resource": "arn:aws:states:::ecs:runTask.sync",
            "Parameters": {
              "LaunchType": "FARGATE",
              "PlatformVersion": "LATEST",
              "Cluster": "${ClusterArn}",
              "TaskDefinition": "${TaskDefinitionArn}",
              "NetworkConfiguration": {
                "AwsvpcConfiguration": {
                  "Subnets": ["${SubnetA}", "${SubnetB}"],
                  "SecurityGroups": ["${TaskSecurityGroupId}"],
                  "AssignPublicIp": "ENABLED"
                }
              },
              "Overrides": {
                "ContainerOverrides": [
                  {
                    "Name": "pipeline",
                    "Command.$": "States.Array('--stage', 'm5', '--year', States.Format('{}', $.session.year), '--session-key', States.Format('{}', $.session.session_key))"
                  }
                ]
              }
            },
            "ResultSelector": {
              "exit_code.$": "$.Containers[0].ExitCode",
              "task_arn.$": "$.TaskArn"
            },
            "ResultPath": "$.m5",
            "TimeoutSeconds": 900,
            "Retry": [
              {
                "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
                "IntervalSeconds": 60,
                "MaxAttempts": 3,
                "BackoffRate": 2
              },
              {
                "ErrorEquals": ["States.TaskFailed"],
                "IntervalSeconds": 60,
                "MaxAttempts": 1
              }
            ],
            "Next": "CheckM5ExitCode"
          },
          "CheckM5ExitCode": {
            "Type": "Choice",
            "Choices": [
              {
                "Variable": "$.m5.exit_code",
                "NumericEquals": 0,
                "Next": "SessionDone"
              }
            ],
            "Default": "M5ExitedNonZero"
          },
          "M5ExitedNonZero": {
            "Type": "Fail",
            "Error": "StageExitedNonZero",
            "Cause": "M5 (features) exited with a non-zero code; see the task logs."
          },
          "SessionDone": {
            "Type": "Succeed"
          }
        }
      },
      "ResultPath": null,
      "Next": "M6_ModelingDataset",
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ]
    },
    "M6_ModelingDataset": {
      "Type": "Task",
      "Comment": "--stage m6, once every session has been processed: a global batch, since the temporal split needs the whole history (it ignores any session scope). Reads features/, writes modeling/ and manifests/modeling/.",
      "Resource": "arn:aws:states:::ecs:runTask.sync",
      "Parameters": {
        "LaunchType": "FARGATE",
        "PlatformVersion": "LATEST",
        "Cluster": "${ClusterArn}",
        "TaskDefinition": "${TaskDefinitionArn}",
        "NetworkConfiguration": {
          "AwsvpcConfiguration": {
            "Subnets": ["${SubnetA}", "${SubnetB}"],
            "SecurityGroups": ["${TaskSecurityGroupId}"],
            "AssignPublicIp": "ENABLED"
          }
        },
        "Overrides": {
          "ContainerOverrides": [
            {
              "Name": "pipeline",
              "Command": ["--stage", "m6"]
            }
          ]
        }
      },
      "ResultSelector": {
        "exit_code.$": "$.Containers[0].ExitCode",
        "task_arn.$": "$.TaskArn"
      },
      "ResultPath": "$.m6",
      "TimeoutSeconds": 1800,
      "Retry": [
        {
          "ErrorEquals": ["AmazonECS.Unknown", "ECS.AmazonECSException", "ECS.ServerException"],
          "IntervalSeconds": 60,
          "MaxAttempts": 3,
          "BackoffRate": 2
        },
        {
          "ErrorEquals": ["States.TaskFailed"],
          "IntervalSeconds": 60,
          "MaxAttempts": 1
        }
      ],
      "Catch": [
        {
          "ErrorEquals": ["States.ALL"],
          "ResultPath": "$.error",
          "Next": "NotifyPipelineFailure"
        }
      ],
      "Next": "CheckM6ExitCode"
    },
    "CheckM6ExitCode": {
      "Type": "Choice",
      "Choices": [
        {
          "Variable": "$.m6.exit_code",
          "NumericEquals": 0,
          "Next": "PipelineSucceeded"
        }
      ],
      "Default": "M6ExitedNonZero"
    },
    "M6ExitedNonZero": {
      "Type": "Pass",
      "Result": {
        "Error": "StageExitedNonZero",
        "Cause": "M6 (modelling dataset) exited with a non-zero code; see its logs in the pipeline log group."
      },
      "ResultPath": "$.error",
      "Next": "NotifyPipelineFailure"
    },
    "PipelineSucceeded": {
      "Type": "Succeed"
    },
    "NotifyPipelineFailure": {
      "Type": "Task",
      "Comment": "Critical: a pipeline stage failed after its retries.",
      "Resource": "arn:aws:states:::sns:publish",
      "Parameters": {
        "TopicArn": "${AlertTopicArn}",
        "Subject": "[${Environment}] F1 Race Intelligence pipeline failed",
        "Message.$": "States.JsonToString($)"
      },
      "ResultPath": "$.notification",
      "Next": "PipelineFailed"
    },
    "PipelineFailed": {
      "Type": "Fail",
      "Error": "PipelineFailed",
      "Cause": "A pipeline stage failed; details were published to the alert topic."
    }
  }
}
