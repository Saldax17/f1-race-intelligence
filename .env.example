# Copy this file to .env to override configs/config.yaml without editing it.
# OpenF1 does not require authentication for historical data, so this file
# currently only controls client behavior (base URL, rate limits, retries, logging).

OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_RATE_LIMIT_RPS=3
OPENF1_RATE_LIMIT_RPM=30
OPENF1_RETRY_MAX_ATTEMPTS=3
LOG_LEVEL=INFO

# Optional: point to a different config file entirely
# F1_CONFIG_PATH=configs/config.yaml
