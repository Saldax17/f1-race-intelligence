# Copy this file to .env to override configs/config.yaml without editing it.
# OpenF1 does not require authentication for historical data, so no API key
# is needed. Never put AWS credentials in this file: use an IAM role in AWS
# and the standard AWS credential chain (aws configure / SSO) locally.

OPENF1_BASE_URL=https://api.openf1.org/v1
OPENF1_RATE_LIMIT_RPS=3
OPENF1_RATE_LIMIT_RPM=30
OPENF1_RETRY_MAX_ATTEMPTS=3
LOG_LEVEL=INFO

# Optional: point to a different config file entirely
# F1_CONFIG_PATH=configs/config.yaml

# Optional: development log file (logs always go to stdout as well)
# F1_LOG_FILE=logs/pipeline.log

# Environment and storage (defaults: local files, historical layout)
# F1_ENVIRONMENT=local                 # local | aws
# F1_STORAGE_BACKEND=local             # local | s3
# F1_STORAGE_LAYOUT=auto               # auto | legacy | lake
# F1_STORAGE_LOCAL_ROOT=data/lake      # with the lake layout on local disk
# F1_STORAGE_BUCKET=your-bucket-name   # required when backend is s3
# F1_STORAGE_PREFIX=dev
# F1_STORAGE_REGION=us-east-1
# F1_STORAGE_ENDPOINT_URL=http://localhost:4566   # LocalStack/MinIO only
